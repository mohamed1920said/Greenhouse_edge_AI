    {
        "id": "fn_states_text",
        "type": "function",
        "z": "tab_greenhouse",
        "name": "Build ON/OFF state strings",
        "func": "function onoff(v){\n  return (Number(v) === 1) ? \"ON\" : \"OFF\";\n}\n\nconst p = msg.payload || {};\n\nreturn [\n  { payload: onoff(p.heater_state) },\n  { payload: onoff(p.fan_state) },\n  { payload: onoff(p.pump_state) }\n];",
        "outputs": 3,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 640,
        "y": 510,
        "wires": [
            [
                "ui_text_heater"
            ],
            [
                "ui_text_fan"
            ],
            [
                "ui_text_pump"
            ]
        ]
